{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "鲁科影视提词器",
  "version": "2.1.0",
  "identifier": "com.freeprompter.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "console",
        "url": "console.html",
        "title": "鲁科影视提词器",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 660,
        "decorations": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
